  "threatModel": {
    "schemaVersion": 1,
    "ref": "docs/INTDONE_INTDECK_THREAT_MODEL_WHITEPAPER_v0.md",
    "scenarios": {
      "T1-injection": {
        "name": "提示注入 / 输入篡改",
        "description": "攻击者通过自然语言输入或关键词束注入恶意指令，绕过 EthicsGuard / ContentShield",
        "mitigations": ["localContentShield", "e2CoerciveLanguage", "e5ExclusionaryLanguage"],
        "redteamTestRef": "src/core/redteam/redteamGate.v0.test.ts",
        "severity": "high"
      },
      "T2-egress": {
        "name": "越权出站",
        "description": "未经确认的出站请求或绕过 networkEgress=deny 策略",
        "mitigations": ["runOutbound confirmation gate", "compose network_mode:none", "R1-c CPU/mem limits"],
        "redteamTestRef": "src/core/redteam/redteamGate.v0.test.ts [R2-b]",
        "severity": "critical"
      },
      "T3-privilege": {
        "name": "越权操作 / 角色提权",
        "description": "非法角色（非 audit/finance/operator）访问财务导出或策略变更",
        "mitigations": ["evaluatePolicy actor matrix", "FinancialExportDenialCode", "dataSensitivity check"],
        "redteamTestRef": "src/core/redteam/redteamGate.devWorkflow.test.ts",
        "severity": "high"
      },
      "T4-audit-gap": {
        "name": "审计链路缺口",
        "description": "操作发生但未写入 UnifiedAuditEventV1 或 financialAuditStore",
        "mitigations": ["unifiedAuditRingLog", "financialAuditStore de-dup", "G0ActionReportV1"],
        "redteamTestRef": "src/core/redteam/redteamGate.v0.test.ts [experience-lock]",
        "severity": "high"
      },
      "T5-idempotency": {
        "name": "重复提交 / 双写竞态",
        "description": "财务导出重复请求写入多条审计记录导致对账失真",
        "mitigations": ["exportSessionId 幂等键", "csvSha256 去重", "X-Idempotency-Key"],
        "redteamTestRef": "src/core/redteam/redteamGate.devWorkflow.test.ts",
        "severity": "medium"
      },
      "T6-supply-chain": {
        "name": "供应链风险",
        "description": "依赖包引入恶意代码或 baseline 拆仓后双向 merge 污染",
        "mitigations": ["no-bidirectional-merge 原则", "export allowlist", "redteam:v0 CI", "npm ci lockfile"],
        "redteamTestRef": "src/core/redteam/redteamGate.v0.test.ts [T6-supply-chain]",
        "severity": "medium"
      },
      "T7-data-sovereignty": {
        "name": "数据主权越界",
        "description": "C 端数据流入 B 端财务通路，或跨语义复用金额记录",
        "mitigations": ["dataDomain 分离", "personal-spending 数据域", "同源不混义原则"],
        "redteamTestRef": "src/core/redteam/redteamGate.devWorkflow.test.ts",
        "severity": "high"
      }
    }
  },

  "selfCheckGates": {
    "lint":              { "cmd": "npm run lint",              "description": "ESLint 零警告" },
    "test":              { "cmd": "npm test",                  "description": "Vitest 全套单测" },
    "build":             { "cmd": "npm run build",             "description": "TypeScript + Vite 构建" },
    "smoke:profile":     { "cmd": "npm run smoke:profile",     "description": "full/mobile-lite 双形态冒烟" },
    "redteam:v0":        { "cmd": "npm run redteam:v0",        "description": "红队闸门 v0" },
    "lint:themes":       { "cmd": "npm run lint:themes",       "description": "主题内容质量校验" },
    "export:intdeck-baseline": { "cmd": "npm run export:intdeck-baseline -- --dry-run", "description": "baseline 导出 dry-run" },
    "scan:baseline-secrets": { "cmd": "npm run scan:baseline-secrets", "description": "B4 导出物密钥粗扫" }
  },

  "commitConvention": {
    "feat":  "新功能（C/B 产品路径）",
    "fix":   "缺陷修复",
    "docs":  "文档更新/回填",
    "chore": "工程、脚本、配置变更",
    "test":  "新增/修改测试",
    "refactor": "重构（不改外部行为）",
    "security": "安全加固（威胁模型闭环）"
  },

